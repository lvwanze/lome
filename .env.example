# ============================================================
# LOME 环境变量模板(不含任何真实密钥)
#
# 用法:复制为 .env,再按下面的说明填入你自己的资源凭证。
#   cp .env.example .env
#
# 作用域说明,请对号入座:
#   [部署] 腾讯云 CloudBase 云函数的运行时环境变量,由 cloudbase/tools/ 下的
#          部署脚本写入云函数配置,不是本地进程读取的文件。
#   [本地] 只有标注 [本地] 的变量会被本机脚本读取。
#
# 注意:客户端目前不使用本文件。App 的网关地址与环境 ID 硬编码在
#   lib/utils/app_constants.dart 与 lib/services/cloudbase_service.dart,
#   lib/config/env.dart 读取的 CLOUD_ENV_ID / CLOUD_BASE_URL 尚未接入
#   dotenv 加载流程,属于待改造项。
# ============================================================

# [部署] 你自己的 CloudBase 环境 ID(腾讯云控制台 → 云开发 → 环境ID)
ENV_ID=your-cloudbase-env-id

# [部署] JWT 签名密钥。必须是高强度随机串,不要用示例值,不要提交到仓库。
#        生成示例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-32-byte-random-secret

# [部署] 慢信信封加密主密钥环(JSON,版本号为 key 的标识)。
#        生成示例: node -e "const c=require('crypto');console.log(JSON.stringify({k1:c.randomBytes(32).toString('base64')}))"
LETTER_MASTER_KEYS={"k1":"replace-with-base64-of-32-random-bytes"}

# [部署] 当前用于新加密的密钥版本,必须存在于 LETTER_MASTER_KEYS 中。
#        旧版本 key 需继续保留在 LETTER_MASTER_KEYS 里,否则历史信件无法解密。
LETTER_ACTIVE_KEY_VERSION=k1

# ------------------------------------------------------------
# 以下变量只有在你启用对应工具时才需要,可保持注释状态。
# ------------------------------------------------------------

# [本地] 腾讯云账号密钥,仅 cloudbase/tools/cloudbase-mcp-client.js 使用。
#        切勿提交;泄漏后需在腾讯云控制台立即禁用并轮换。
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
